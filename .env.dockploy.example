# App
FLASK_ENV=production
SECRET_KEY=pon_una_clave_larga_y_segura
USE_HTTPS=1
ALLOW_PUBLIC_REGISTRATION=0

# Proxy
TRUST_PROXY=1
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# Gunicorn
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_WORKER_CLASS=eventlet
GUNICORN_TIMEOUT=120

# SocketIO
SOCKETIO_ASYNC_MODE=eventlet
SOCKETIO_CORS_ALLOWED_ORIGINS=@2.25.158.40

# DB App (interna Docker)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=u349183440_crm_orbes

# Compat aliases (algunos paneles usan DB_*/DATABASE_*)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=u349183440_crm_orbes
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=pon_password_mysql
DATABASE_NAME=u349183440_crm_orbes
DATABASE_URL=mysql://root:pon_password_mysql@mysql:3306/u349183440_crm_orbes

# DB Tractor (si comparte mismo servidor)
TRACTOR_DB_HOST=mysql
TRACTOR_DB_PORT=3306
TRACTOR_DB_USER=root
TRACTOR_DB_PASSWORD=pon_password_mysql
TRACTOR_DB_NAME=clinica_tractores_db
TRACTOR_DB_CONNECT_TIMEOUT=8

# MySQL container vars
MYSQL_ROOT_PASSWORD=pon_password_mysql
MYSQL_DATABASE=u349183440_crm_orbes

# IA
OPENAI_API_KEY=
AGENT_MODEL=gpt-3.5-turbo
AGENT_MEMORY_SIZE=10

# Arquitectura distribuida (activado por docker-compose.dockploy.yml)
USE_CELERY=1
WORKFLOW_DISTRIBUTED=1
REDIS_URL=redis://redis:6379/0
AGENT_SERVICE_URL=http://agent-services:8001
WEB_SERVICE_URL=http://app:8000
INTERNAL_SERVICE_SECRET=cambia_este_secreto_interno
