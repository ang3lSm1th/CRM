FLASK_ENV=production
SECRET_KEY=pon_una_clave_larga_y_segura

USE_HTTPS=1
ALLOW_PUBLIC_REGISTRATION=0

TRUST_PROXY=1
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

PORT=8000
WEB_CONCURRENCY=1
GUNICORN_WORKER_CLASS=eventlet
GUNICORN_TIMEOUT=120
SOCKETIO_ASYNC_MODE=eventlet
SOCKETIO_CORS_ALLOWED_ORIGINS=https://tu-dominio.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=pon_password_mysql
MYSQL_DB=u349183440_crm_orbes

# Compat aliases (algunos paneles usan DB_*/DATABASE_*)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pon_password_mysql
DB_NAME=u349183440_crm_orbes
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=pon_password_mysql
DATABASE_NAME=u349183440_crm_orbes
DATABASE_URL=mysql://root:pon_password_mysql@127.0.0.1:3306/u349183440_crm_orbes

TRACTOR_DB_HOST=127.0.0.1
TRACTOR_DB_PORT=3306
TRACTOR_DB_USER=root
TRACTOR_DB_PASSWORD=pon_password_mysql
TRACTOR_DB_NAME=clinica_tractores_db
TRACTOR_DB_CONNECT_TIMEOUT=8

OPENAI_API_KEY=
AGENT_MODEL=gpt-3.5-turbo
AGENT_MEMORY_SIZE=10

# Arquitectura distribuida workflow (Docker: USE_CELERY=1 + WORKFLOW_DISTRIBUTED=1)
USE_CELERY=0
WORKFLOW_DISTRIBUTED=0
REDIS_URL=
AGENT_SERVICE_URL=http://127.0.0.1:8001
WEB_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_SECRET=cambia_este_secreto_interno
AGENT_SERVICE_TIMEOUT=120
